{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build && cp -r dist ../public",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/fastapi/api/$1" },
    { "source": "/sites/(.*)", "destination": "/fastapi/sites/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
