# ============================================================
# Atom 环境变量配置示例
# 复制为 .env 并填入实际值，或在 Vercel 控制台的 Environment Variables 中设置
# ============================================================

# ---------- 数据库 ----------
# Vercel Postgres: 直接使用 Vercel 提供的 POSTGRES_URL
# 本地开发: 留空则自动使用 SQLite (backend/atom.db)
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname?sslmode=require
# POSTGRES_URL=postgres://user:pass@host:5432/dbname

# ---------- LLM 模型配置（OpenAI 兼容接口） ----------
# 不配置 OPENAI_API_KEY 时，系统自动使用模板生成器（无需 API Key）

# === 方案 1: 硅基流动 SiliconFlow（国内推荐，注册送免费额度）===
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=你的_siliconflow_api_key
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct

# === 方案 2: DeepSeek API（价格极低，新用户送额度）===
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=你的_deepseek_api_key
# OPENAI_MODEL=deepseek-chat

# === 方案 3: 智谱 AI BigModel（glm-4-flash 每日免费）===
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_API_KEY=你的_zhipu_api_key
# OPENAI_MODEL=glm-4-flash

# === 方案 4: Ollama 本地模型（完全免费，需本地安装 Ollama）===
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen2.5:7b

# === 方案 5: OpenAI 官方（需科学上网）===
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxxxxx
# OPENAI_MODEL=gpt-4o-mini

# ---------- 存储 ----------
# Vercel Blob: 在 Vercel 控制台添加 Blob 存储后自动获得
# BLOB_READ_WRITE_TOKEN=你的_vercel_blob_token

# 本地存储根目录（留空使用默认值 backend/storage）
# ATOM_STORAGE_ROOT=/tmp/atom-storage

# ---------- 其他 ----------
# 生成网站的公开访问地址前缀（留空则使用相对路径，由前端拼接 origin）
# ATOM_PUBLIC_URL=https://your-domain.com

# Cookie Secure 标志（生产环境设为 1，本地 HTTP 调试设为 0）
# ATOM_COOKIE_SECURE=1

# ---------- 免登录访问 ----------
# 设为 1 时跳过登录，所有请求自动以访客身份访问（适合演示/公开访问）
# ATOM_DISABLE_AUTH=1
